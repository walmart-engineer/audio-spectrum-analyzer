{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "ninja -C build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "ninja -C build flash",
            "problemMatcher": []
        }
    ]
}
